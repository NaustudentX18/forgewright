# forgewright environment variables
# Copy this file to `.env` and fill in the values you need.
# Precedence: CLI flags > env vars > config.toml > defaults

# ─── LLM provider ─────────────────────────────────────────────────────────────
# Pick one. The provider in config.toml takes precedence if set.

# Anthropic
# ANTHROPIC_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# Google (Gemini)
# GOOGLE_API_KEY=

# Azure OpenAI (also requires AZURE_OPENAI_ENDPOINT and AZURE_OPENAI_DEPLOYMENT)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# AWS Bedrock (uses the AWS SDK credential chain — no key needed here if `aws sso` is configured)
# AWS_REGION=us-east-1
# AWS_PROFILE=default

# Ollama (no key; just a base URL)
# OLLAMA_BASE_URL=http://localhost:11434

# OpenRouter (OpenAI-compatible)
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ─── forgewright-wide ─────────────────────────────────────────────────────────
# Override the config file location
# FORGEWRIGHT_CONFIG=/path/to/config.toml

# Override the workspace directory
# FORGEWRIGHT_WORKSPACE=./workspace

# Override the logs directory
# FORGEWRIGHT_LOGS=./logs

# Enable debug logging
# FORGEWRIGHT_LOG_LEVEL=DEBUG

# Output logs as JSON (for SIEM ingestion)
# FORGEWRIGHT_LOG_FORMAT=json

# Skip all interactive prompts (CI mode). Use with care.
# FORGEWRIGHT_AUTO_APPROVE=1

# ─── MCP server auth ──────────────────────────────────────────────────────────
# Bearer tokens for HTTP-based MCP servers, read by name.
# GITHUB_TOKEN=
# POSTGRES_TOKEN=
# SLACK_TOKEN=

# ─── Tracing / observability ─────────────────────────────────────────────────
# OpenTelemetry endpoint for MCP and LLM spans.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=YOUR_KEY

# IMPORTANT: do NOT set TRACELOOP_TRACE_CONTENT=true in production
# (it embeds prompt content into spans).
# TRACELOOP_TRACE_CONTENT=false

# ─── Sandbox ──────────────────────────────────────────────────────────────────
# Override the sandbox backend choice.
# FORGEWRIGHT_SANDBOX=docker   # subprocess | docker | gvisor

# Override the default Docker image for PythonExecute.
# FORGEWRIGHT_SANDBOX_IMAGE=python:3.12-slim

# Override the memory limit for the Docker sandbox.
# FORGEWRIGHT_SANDBOX_MEM=512m

# ─── Notes ────────────────────────────────────────────────────────────────────
# • Secrets set via `forgewright secrets set <name>` are stored in your OS keyring
#   and take precedence over these env vars.
# • Never commit a populated .env file. Add it to .gitignore (it already is).
# • These vars are the union of what forgewright, litellm, fastmcp, and the
#   various provider SDKs understand. Forgewright itself only reads the
#   FORGEWRIGHT_* and provider API key variables.
