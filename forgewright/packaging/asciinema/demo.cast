[14.632528, "o", "\r\n\u001b[36m                                         \u001b[0m\r\n\u001b[36m \u001b[0m\u001b[36mCommand\u001b[0m\u001b[1m      \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mDescription\u001b[0m\u001b[1m             \u001b[0m\u001b[36m \u001b[0m\r\n\u001b[36m ─────────────────────────────────────── \u001b[0m\r\n\u001b[36m \u001b[0m/help         \u001b[36m \u001b[0mShow this help          \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0m/clear        \u001b[36m \u001b[0mClear the screen        \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0m/exit         \u001b[36m \u001b[0mSave and exit           \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0m/status       \u001b[36m \u001b[0mShow session status     \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0m/model [name] \u001b[36m \u001b[0mShow or switch the model\u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0m/resume [id   \u001b[36m \u001b[0mlast]                   \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0m/sessions     \u001b[36m \u001b[0mList recent sessions    \u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0m/doctor       \u001b[36m \u001b[0mRun diagnostics         \u001b[36m \u001b[0m\r\n\u001b[36m                                         \u001b[0m\r\n"]
[14.636066, "o", "\u001b[?2004h\u001b[?25l\u001b[0m\u001b[?7l\u001b[0m\u001b[J\u001b[0m> /exit\u001b[7D\u001b[7C\u001b[?7h\u001b[0m\u001b[?12l\u001b[?25h"]
