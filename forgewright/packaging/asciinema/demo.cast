[0.006495, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.00732, "o", "\r\n  forgewright — an open-source, CLI-first AI agent framework.\r\n  https://github.com/forest/forgewright\r\n\r\n"]
[1.209563, "o", "$ forgewright --version\r\n"]
[1.80837, "o", "forgewright 0.1.0\r\n"]
[3.476112, "o", "\r\n$ forgewright --help\r\n"]
[4.165964, "o", "                                                                                                    \r\n Usage: forgewright [OPTIONS] COMMAND [ARGS]...                                                     \r\n                                                                                                    \r\n"]
[4.174046, "o", " forgewright — an open-source, CLI-first AI agent framework.                                        \r\n                                                                                                    \r\n Run `forgewright build \"<prompt>\"` to execute a single task, `forgewright resume` to continue a    \r\n previous session, or just `forgewright` to open the REPL.                                          \r\n                                                                                                    \r\n"]
[4.17573, "o", "╭─ Options ────────────────────────────────────────────────────────────────────────────────────────╮\r\n│ --version          Show the forgewright version and exit.                                        │\r\n│ --help             Show this message and exit.                                                   │\r\n╰──────────────────────────────────────────────────────────────────────────────────────────────────╯\r\n"]
[4.180027, "o", "╭─ Commands ───────────────────────────────────────────────────────────────────────────────────────╮\r\n│ build      Run a single prompt through the Manus agent.                                          │\r\n│ init       Initialize forgewright config in ~/.config/forgewright/.                              │\r\n│ browse     Open a URL in a headless browser and report the page title (Phase 5 manual path).     │\r\n│ mcp        MCP server / client operations. Sub-actions: serve, connect, ls, install, trust. Try  │\r\n│            `forgewright mcp serve --help`.                                                       │\r\n│ mcp-serve  Shortcut for `forgewright mcp serve` (FastMCP server).                                │\r\n│ flow       Decompose a high-level task into ordered sub-agent steps and run them (Phase 9        │\r\n"]
[5.646707, "o", "\r\n$ forgewright build \"say hi\"\r\n"]
[7.599709, "o", "\u001b[32m22:57:25\u001b[0m | \u001b[1mINFO   \u001b[0m | \u001b[36mforgewright.cli.main\u001b[0m:\u001b[36mbuild_command\u001b[0m:\u001b[36m81\u001b[0m | \u001b[1mbuild.start provider=stub model=stub-model max_steps=8\u001b[0m\r\n"]
