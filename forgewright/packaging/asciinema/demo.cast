[16.324135, "o", "\r\n  Install:\r\n    pipx install forgewright\r\n    brew  install forest/tap/forgewright\r\n"]
[16.324174, "o", "    docker run --rm ghcr.io/forest/forgewright\r\n\r\n  -> https://github.com/forest/forgewright\r\n\r\n"]
